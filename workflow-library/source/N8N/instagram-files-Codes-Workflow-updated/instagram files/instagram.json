      "id": "67fe5a2b-0119-4573-9d0d-4ea21dfd84a7",
      "name": "Sticky Note"
    },
    {
      "parameters": {
        "jsCode": "// الحصول على كومنت العميل من الـ Webhook\nconst msg = $('Webhook').first().json.body.entry[0].changes[0].value.text\n\n// الحصول على الكلمات المفتاحية من المدخلات\nconst checkfrom = $input.first().json.comment;\n// متغير لحفظ النتيجة النهائية\nlet isMatch = false;\n\n// التحقق مما إذا كان `checkfrom` فارغاً أو يحتوي على 'any'\nif (!checkfrom || checkfrom.trim() === '' || checkfrom.toLowerCase().includes('any')) {\n  isMatch = true;\n} else {\n  // تحويل الكومنت والكلمات المفتاحية إلى حروف صغيرة\n  const lowerCaseMsg = msg.toLowerCase();\n  const lowerCaseCheckfrom = checkfrom.toLowerCase();\n\n  // تقسيم الكلمات المفتاحية بناءً على الفاصلة\n  const keywords = lowerCaseCheckfrom.split(',');\n\n  // تكرار على كل كلمة مفتاحية\n  for (const keyword of keywords) {\n    // إزالة الفراغات البيضاء حول الكلمة المفتاحية\n    const trimmedKeyword = keyword.trim();\n    // التحقق إذا كان الكومنت يحتوي على الكلمة المفتاحية\n    if (trimmedKeyword !== '' && lowerCaseMsg.includes(trimmedKeyword)) {\n      isMatch = true;\n      // الخروج من الحلقة بمجرد العثور على تطابق واحد\n      break;\n    }\n  }\n}\n\n// إرجاع النتيجة\nreturn {\n  json: {\n    status: isMatch,\n  }\n};"
      },
