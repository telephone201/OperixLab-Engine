      "parameters": {
        "jsCode": "// النص الكامل من ChatGPT\nconst message = $input.first().json.output; // أو من مكان التخزين في n8n\n\n// استخراج الجزء اللي بين ```json و ```\nconst jsonMatch = message.match(/```json\\s*([\\s\\S]*?)```/);\n\nif (jsonMatch && jsonMatch[1]) {\n  const jsonString = jsonMatch[1];\n  const orderData = JSON.parse(jsonString);\n\n  return {\n    json: {\n      customer_name: orderData.customer_name,\n      address: orderData.address,\n      phone: orderData.phone,\n      order: orderData.order,\n      is_order_complete: orderData.is_order_complete\n    }\n  };\n} else {\n  return {\n    json: {\n      error: \"لم يتم العثور على JSON في الرسالة\"\n    }\n  };\n}"
      },
