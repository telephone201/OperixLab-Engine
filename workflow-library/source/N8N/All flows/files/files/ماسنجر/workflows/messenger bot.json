        "jsCode": "// في Code Node\nconst currentTimestamp = $input.first().json.body.entry[0].messaging[0].timestamp; // 1748740358256\nconst currentDate = new Date(currentTimestamp); // تحويل لتاريخ عادي\nconst expiryDate = new Date(currentTimestamp + (24 * 60 * 60 * 1000)); // إضافة 24 ساعة\n\n// تحويل للصيغة المطلوبة للـ MySQL\nconst stoppedAt = currentDate.toISOString().slice(0, 19).replace('T', ' ');\nconst expiresAt = expiryDate.toISOString().slice(0, 19).replace('T', ' ');\n\nreturn [{\n  json: {\n    user_id: $input.first().json.body.entry[0].messaging[0].sender.id,\n    stopped_at: stoppedAt,    // مثال: 2025-01-31 15:45:58\n    expires_at: expiresAt     // مثال: 2025-02-01 15:45:58\n  }\n}];"
